{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "group-order",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "group-order-db",
			"database_id": "327ed2c7-4fe9-43a7-af35-4a884f9325a3"
		}
	]
}